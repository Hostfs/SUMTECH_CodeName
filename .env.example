# 배포·로컬 실행용 환경변수 예시. 이름과 기본값만 적고, 키·비밀번호 값은 넣지 않는다.
# 서버에서는 이 파일을 .env로 복사해 값을 채운다(cp .env.example .env, chmod 600 .env). .env는 git에 올리지 않는다.
# 채점·CI의 docker compose는 이 파일을 읽지 않는다(docker-compose.yml에 값이 따로 있다).

# 앱이 받는 포트. nginx 같은 역방향 프록시 뒤에 두면 3000 그대로 두고 외부에는 열지 않는다.
PORT=3000

# MariaDB 10.4 이상. 같은 서버의 3306, 전용 DB·계정을 쓴다(비우면 아래 기본값).
DATABASE_URL=jdbc:mariadb://127.0.0.1:3306/otgyeol
DATABASE_USERNAME=otgyeol
DATABASE_PASSWORD=

# /__health가 돌려줄 배포 버전. 배포한 commit SHA를 넣는다(비우면 dev).
RELEASE_ID=

# 예시(시드) 계정. 로컬·채점용 docker에서만 쓰고, 공개 배포 서버에서는 비워 둔다.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# 택 분석·제품 검색. Vercel AI Gateway 키 또는 Google AI Studio(Gemini) 키(AQ.…·AIza…면 Google로 바로 보낸다).
# 비어 있어도 서버는 뜨고, AI 기능만 '직접 입력으로 계속' 안내로 바뀐다.
AI_GATEWAY_API_KEY=
# 비우면 키 종류에 맞는 기본 모델(Gateway: google/gemini-2.5-flash, Gemini 키: gemini-flash-lite-latest)
AI_MODEL=

# 현재 위치 날씨(R12). 기상청 단기예보 조회서비스(공공데이터포털) 인증키. 인코딩 키·디코딩 키 어느 쪽이든 된다.
# 비어 있으면 서버는 뜨고, 내 옷장의 날씨 카드만 안내 문구로 바뀐다. 위치 권한 때문에 HTTPS 주소에서만 동작한다.
KMA_API_KEY=
