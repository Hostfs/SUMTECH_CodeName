# 변수 이름만 적습니다. 실제 값은 로컬 환경변수·배포 서버의 .env·GitHub Secrets에 넣습니다.
# MariaDB (비우면 jdbc:mariadb://127.0.0.1:3306/otgyeol, 계정 otgyeol/otgyeol)
DATABASE_URL=jdbc:mariadb://127.0.0.1:3306/otgyeol
DATABASE_USERNAME=otgyeol
DATABASE_PASSWORD=
# 서비스 AI 기능(택 분석·제품 검색·추천)
AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash
