# 옷결 서버 설정. install.sh가 처음 설치할 때 이 파일을 .env로 복사한다.
# .env는 chmod 600으로 두고 내용을 출력하거나 공유하지 않는다. 저장소에는 키를 넣지 않는다.

# MariaDB(10.4 이상). 비밀번호를 비워 두면 install.sh가 만들어 넣는다.
DATABASE_URL=jdbc:mariadb://127.0.0.1:3306/otgyeol
DATABASE_USERNAME=otgyeol
DATABASE_PASSWORD=

# 서비스 AI(택 분석·제품 검색). Vercel AI Gateway 키 또는 Google AI Studio(Gemini) 키.
# Gemini 키(AQ.…·AIza…)면 Google로 바로 보낸다. 비어 있어도 서버는 뜨고 AI 기능만 '직접 입력' 안내를 보여 준다.
AI_GATEWAY_API_KEY=
# 비워 두면 키 종류에 맞는 기본 모델(Gateway: google/gemini-2.5-flash, Gemini 키: gemini-flash-lite-latest)
AI_MODEL=

# 현재 위치 날씨(R12). 기상청 단기예보 조회서비스(공공데이터포털) 인증키. 인코딩·디코딩 키 어느 쪽이든 된다.
KMA_API_KEY=

# 앱이 받는 포트. nginx 뒤에 두므로 외부에는 열지 않는다.
PORT=3000

# 배포 서버에서는 시드(예시) 계정을 만들지 않는다. 비워 둔다.
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# 발표·QR 체험용 게스트 로그인. on이면 첫 화면·로그인 화면에 '게스트로 체험하기'가 생기고,
# 누를 때마다 예시 옷장(옷 11벌·공간 8곳)이 든 새 계정으로 바로 들어간다. 체험이 끝나면 off로 돌린다.
GUEST_MODE=off
